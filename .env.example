# ─────────────────────────────────────────────────────────────────────────────
# Euron Video System: environment for running services OUTSIDE Docker
# (e.g. `pnpm dev` against the Floci emulator started by `make up`).
#
#   cp .env.example .env     # .env is git-ignored
#
# The authoritative schema (types, defaults, validation) is
# packages/core/src/config/index.ts; docs/guides/configuration.md explains each
# variable. Values below are LOCAL placeholders. Generate real secrets with:
#   openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ─── Core (every runtime) ────────────────────────────────────────────────────
NODE_ENV=development
# LOG_LEVEL=debug                       # error | warn | info | debug
EVS_CLOUD=floci                         # floci | aws (log context only)
DATABASE_URL=postgres://evs:evs@localhost:5432/evs
# On AWS, instead of DATABASE_URL: read the password from the RDS-managed secret
# for every new connection, so RDS password rotation needs no restart.
# DATABASE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:evs-db-example
# DB_HOST=evs-dev.example.us-east-1.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=evs
# DB_USER=evs_admin
# DB_SSL=require            # disable | require | verify-full (verify-full needs DB_SSL_CA_FILE)
# DB_SSL_CA_FILE=/etc/ssl/rds-global-bundle.pem
# PG_POOL_MAX=10
# PG_POOL_MIN=0
# PG_CONNECTION_TIMEOUT_MS=10000
# PG_IDLE_TIMEOUT_MS=10000
# PG_STATEMENT_TIMEOUT_MS=30000

AWS_REGION=us-east-1
# Emulator only; leave all three unset for real AWS (default credential chain).
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_FORCE_PATH_STYLE=true
# Browser-reachable endpoint used only for presigned URLs.
# S3_PUBLIC_ENDPOINT=http://localhost:4566

UPLOADS_BUCKET=evs-local-uploads
MEDIA_BUCKET=evs-local-media
DOWNLOADS_BUCKET=evs-local-downloads
# Unset = local AES-256-GCM wrapping derived from DATA_ENCRYPTION_KEY.
KMS_KEY_ID=alias/evs-local
DATA_ENCRYPTION_KEY=replace-with-output-of-make-env-000000000000

# ─── API ─────────────────────────────────────────────────────────────────────
PORT=8080
# CLUSTER_WORKERS=1                     # 0 = one per CPU
PUBLIC_API_BASE=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# TRUST_PROXY_HOPS=1
API_KEY_PEPPER=replace-with-output-of-make-env-000000000000
PLAYBACK_SIGNING_KEYS=k1=replace-with-output-of-make-env-00000000000
PLAYBACK_ACTIVE_KID=k1
# PLAYBACK_TOKEN_ISSUER=evs
DELIVERY_DRIVER=proxy                   # cloudfront-signed | presigned | proxy | public
# MEDIA_PUBLIC_BASE=https://dxxxxxxxxxxxxx.cloudfront.net
# CLOUDFRONT_KEY_PAIR_ID=KXXXXXXXXXXXXX
# CLOUDFRONT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# MAX_UPLOAD_BYTES=21474836480
# MAX_IN_FLIGHT=50
# RATE_LIMIT_PER_MINUTE=600
# PLAYBACK_RATE_LIMIT_PER_MINUTE=3000
# WEBHOOK_DISPATCH_ENABLED=true
# WEBHOOK_TIMEOUT_MS=10000

# ─── Worker ──────────────────────────────────────────────────────────────────
WORKER_PLATFORM=local                   # ec2 | local
# WORKER_MODE=all                       # all | primary | jobs
# WORKER_ID=
# IDLE_GRACE_MS=120000
# POLL_MS=5000
# HEARTBEAT_MS=30000
# WORKER_DRY_RUN_SHUTDOWN=true
# WORK_DIR=/tmp/evs
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# WHISPER_BIN=/opt/whisper.cpp/whisper-cli
# WHISPER_MODEL=/opt/models/ggml-small.bin
CAPTIONS_ENABLED=false                  # needs whisper.cpp locally
# CAPTIONS_DEFAULT_LANG=en
# LADDER_PRESET=medium
# LADDER_CRF=19
# CAP_TO_SOURCE=true
# CAP_TO_SOURCE_FACTOR=1.1
# CAP_TO_SOURCE_FLOOR=0.6
# MIN_OUTPUT_FPS=24
# DOWNLOAD_ENABLED=true
# DOWNLOAD_VIDEO_CODEC=libx264          # libx264 | libx265
# DOWNLOAD_CRF=23
# DOWNLOAD_PRESET=medium
# DOWNLOAD_MAXRATE_KBPS=2800

# ─── Orchestrator ────────────────────────────────────────────────────────────
LAUNCHER=noop                           # ec2-spot | noop
# ORCHESTRATOR_INTERVAL_MS=60000
# MAX_WORKERS=20
# DIVISOR=1
# LAUNCH_TEMPLATE_NAME=evs-dev-worker-primary
# LAUNCH_TEMPLATE_VERSION=$Latest
# WORKER_SUBNET_IDS=subnet-aaaa,subnet-bbbb
# WORKER_INSTANCE_TYPES=c7g.4xlarge,c7g.2xlarge,c7g.xlarge,c6g.xlarge,m7g.xlarge
# WORKER_ROLE_TAG=evs-transcoder
# SPOT_ALLOCATION_STRATEGY=price-capacity-optimized
# ONDEMAND_FALLBACK=false
# JOBS_LAUNCH_TEMPLATE_NAME=
# JOBS_INSTANCE_TYPES=c7g.xlarge,c6g.xlarge,m7g.xlarge
# JOBS_ROLE_TAG=evs-transcoder-jobs
# JOBS_MAX_WORKERS=10
