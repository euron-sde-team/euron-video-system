{
  "name": "@evs/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Control plane and playback API: videos, API keys, playback policies and sessions, webhooks, audit, usage, tokenized HLS and key delivery.",
  "scripts": {
    "dev": "EVS_SERVICE=api tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --external:pg-native --sourcemap --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/index.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/cloudfront-signer": "^3.700.0",
    "@evs/core": "workspace:*",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.28.8",
    "prom-client": "^15.1.3",
    "ulid": "^2.3.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.24.0",
    "supertest": "^7.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
