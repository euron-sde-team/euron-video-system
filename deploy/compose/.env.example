# ─────────────────────────────────────────────────────────────────────────────
# deploy/compose/.env: LOCAL-ONLY throwaway secrets for the compose stack.
# Do not hand-edit for production. Generate fresh random values with:
#     make env        (runs scripts/demo/gen-local-env.sh)
# The real file (.env) is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# 32+ chars. HKDF root for local content-key wrapping and sealed webhook secrets.
EVS_DATA_ENCRYPTION_KEY=replace-with-output-of-make-env-000000000000
# 32+ chars. HMAC pepper for API key hashes.
EVS_API_KEY_PEPPER=replace-with-output-of-make-env-000000000000
# Keyring "kid=secret[,kid=secret]"; secrets 32+ chars.
EVS_PLAYBACK_SIGNING_KEYS=k1=replace-with-output-of-make-env-00000000000
EVS_PLAYBACK_ACTIVE_KID=k1

# Optional tuning
# EVS_PUBLIC_API_BASE=http://localhost:8080
# EVS_CORS_ALLOWED_ORIGINS=http://localhost:3000
# EVS_DELIVERY_DRIVER=proxy          # floci overlay: proxy | presigned
# EVS_WORKER_REPLICAS=2
# EVS_LADDER_PRESET=veryfast
# EVS_CAPTIONS=true                  # false = slim worker image without whisper.cpp
# EVS_WHISPER_MODEL=base             # tiny | base | small | medium
# EVS_LOG_LEVEL=info
# EVS_PG_PORT=5432                   # host port for Postgres if 5432 is taken
